{
  "name": "salon-booking",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "build:pages": "tsc -b && vite build --mode pages",
    "preview:pages": "vite preview --base /salon-booking/",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:migrations": "python tests/verify_migrations.py",
    "test:browser": "node tests/browser-smoke.mjs",
    "lint": "eslint src worker vite.config.ts",
    "test:browser:admin": "node tests/admin-browser-smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.72.1",
    "axe-core": "^4.14.0"
  }
}
